{%- set t = tr[lang] -%}
{%- set meta = t[pagekey].meta -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ meta.title }}</title>
  <meta name="description" content="{{ meta.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ 'en' if lang == 'no' else 'no' }}" href="{{ site.url }}{{ alt }}">
  <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
  <script>(function(){try{var q=new URLSearchParams(location.search).get('concept');var c=q||localStorage.getItem('nc-concept');if(c&&/^[abc]$/.test(c)){document.documentElement.setAttribute('data-concept',c);if(q)localStorage.setItem('nc-concept',c);}}catch(e){}})();</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:title" content="{{ meta.title }}">
  <meta property="og:description" content="{{ meta.description }}">
  <meta property="og:image" content="{{ site.url }}/img/patrick-hero-640.jpg">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ 'nb_NO' if lang == 'no' else 'en_GB' }}">
  <meta property="og:locale:alternate" content="{{ 'en_GB' if lang == 'no' else 'nb_NO' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Manrope:wght@500;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/concepts.css">
</head>
<body class="page-{{ pagekey }}">
<a class="skip" href="#main">{{ 'Hopp til innhold' if lang == 'no' else 'Skip to content' }}</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="{{ '/' if lang == 'no' else '/en/' }}" aria-label="NovaCoach">
      <span class="brand-mark" aria-hidden="true"></span><span class="brand-name">Nova<b>Coach</b></span>
    </a>
    <nav class="nav" aria-label="{{ 'Hovedmeny' if lang == 'no' else 'Main menu' }}">
      {%- if lang == 'no' -%}
      <a href="/kurs/">{{ t.nav.kurs }}</a>
      <a href="/coaching/">{{ t.nav.coaching }}</a>
      <a href="/om-patrick/">{{ t.nav.om }}</a>
      <a href="/kontakt/" class="nav-cta btn btn-small">{{ t.nav.cta }}</a>
      {%- else -%}
      <a href="/en/courses/">{{ t.nav.kurs }}</a>
      <a href="/en/coaching/">{{ t.nav.coaching }}</a>
      <a href="/en/about/">{{ t.nav.om }}</a>
      <a href="/en/contact/" class="nav-cta btn btn-small">{{ t.nav.cta }}</a>
      {%- endif -%}
      <a href="{{ alt }}" class="lang" lang="{{ 'en' if lang == 'no' else 'no' }}" hreflang="{{ 'en' if lang == 'no' else 'no' }}">{{ t.nav.switch }}</a>
    </nav>
  </div>
</header>
{%- if pagekey == 'home' %}
<section class="concept-picker" id="concept-picker" hidden aria-label="{{ t.common.concepts.title }}">
  <div class="inner">
    <h1>{{ t.common.concepts.title }}</h1>
    <p class="lead">{{ t.common.concepts.lead }}</p>
    <div class="concept-grid">
      {%- for o in t.common.concepts.options %}
      <button type="button" class="concept-card sw-{{ o.key }}" data-pick="{{ o.key }}">
        <span class="swatch"><span class="s1">NovaCoach</span><span class="s2"></span></span>
        <span class="body"><b>{{ o.key | upper }} · {{ o.name }}</b><p>{{ o.p }}</p><span class="pick">{{ t.common.concepts.pick }}</span></span>
      </button>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
<main id="main">
{{ content | safe }}
</main>
<div class="concept-switch" role="group" aria-label="{{ t.common.concepts.switch }}"><span>{{ t.common.concepts.switch }}</span>
  <button type="button" data-pick="a" aria-pressed="false">A</button><button type="button" data-pick="b" aria-pressed="false">B</button><button type="button" data-pick="c" aria-pressed="false">C</button>
</div>
<script>
(function(){
  var root=document.documentElement, picker=document.getElementById('concept-picker');
  function current(){return root.getAttribute('data-concept')||'a';}
  function apply(c){root.setAttribute('data-concept',c);try{localStorage.setItem('nc-concept',c);}catch(e){}
    document.querySelectorAll('.concept-switch button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.pick===c?'true':'false');});
    if(picker){picker.hidden=true;}}
  var chosen=null;try{chosen=localStorage.getItem('nc-concept');}catch(e){}
  if(!root.getAttribute('data-concept')){ if(picker&&!chosen){picker.hidden=false;} else {root.setAttribute('data-concept','a');} }
  document.querySelectorAll('.concept-switch button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.pick===current()?'true':'false');});
  document.querySelectorAll('[data-pick]').forEach(function(el){el.addEventListener('click',function(){apply(el.dataset.pick);});});
})();
</script>
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-col">
      <span class="brand-name">Nova<b>Coach</b></span>
      <p class="tagline">{{ t.footer.tagline }}</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a><br><a href="{{ site.linkedin }}" rel="me noopener" target="_blank">{{ t.footer.linkedin }}</a></p>
    </div>
    <div class="footer-col small">
      <p>{{ t.footer.legal | replace("{legalName}", site.legalName) | replace("{orgnr}", site.orgnr) | replace("{address}", site.address) }}</p>
      <p>{{ t.footer.trademark }}</p>
      <p><a href="{{ '/personvern/' if lang == 'no' else '/en/privacy/' }}">{{ t.common.privacyLink }}</a></p>
    </div>
  </div>
</footer>
</body>
</html>
