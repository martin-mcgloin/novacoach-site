{%- set t = tr[lang] -%}
{%- set h = t.home -%}
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{{ h.eyebrow }}</p>
      <h1>{{ h.h1 }}</h1>
      <p class="lead">{{ h.lead }}</p>
      <div class="actions">
        <a class="btn" href="#interesse">{{ t.common.cta }}</a>
        <a class="btn btn-ghost" href="{{ '/kurs/' if lang == 'no' else '/en/courses/' }}">{{ t.common.ctaCourses }}</a>
      </div>
      <ul class="facts">
        {%- for f in t.common.facts %}<li>{{ f }}</li>{% endfor -%}
      </ul>
    </div>
    <figure class="hero-photo">
      <img src="/img/patrick-hero.jpg" srcset="/img/patrick-hero-640.jpg 640w, /img/patrick-hero.jpg 1050w" sizes="(min-width: 900px) 40vw, 90vw" alt="Patrick Mc Gloin" width="1050" height="1400" fetchpriority="high">
    </figure>
  </div>
</section>

<section class="wrap block">
  <h2 class="h2-rule">{{ h.forTitle }}</h2>
  <div class="cards-3">
    {%- for a in h.audiences %}
    <article class="card-plain">
      <h3>{{ a.h }}</h3>
      <p>{{ a.p }}</p>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="wrap block">
  <h2 class="h2-rule">{{ h.modelsTitle }}</h2>
  <p class="lead">{{ h.modelsLead }}</p>
  <div class="models">
    <figure>
      <img src="/img/rundkjoring.jpg" alt="{{ h.models.roundabout.alt }}" width="812" height="502" loading="lazy">
      <figcaption>{{ h.models.roundabout.caption }}</figcaption>
    </figure>
    <figure>
      <div class="sheet"><img src="/img/normalprofil.png" alt="{{ h.models.section.alt }}" width="1469" height="302" loading="lazy"></div>
      <figcaption>{{ h.models.section.caption }}</figcaption>
    </figure>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <h2 class="h2-rule">{{ h.offersTitle }}</h2>
    <div class="cards-2">
      {%- for o in t.offers %}
      <article class="card">
        <p class="tag">{{ o.tag }}</p>
        <h3><a href="{{ o.href }}">{{ o.h }}</a></h3>
        <p>{{ o.p }}</p>
        <a class="more" href="{{ o.href }}">{{ t.common.readMore }}</a>
      </article>
      {%- endfor %}
    </div>
    <p class="note">{{ t.common.noPrices }}</p>
  </div>
</section>

<section class="wrap block why">
  <div class="why-grid">
    <div>
      <h2 class="h2-rule">{{ h.whyTitle }}</h2>
      {%- for p in h.why %}<p class="{{ 'big' if loop.first }}">{{ p }}</p>{% endfor %}
      <a class="more" href="{{ '/om-patrick/' if lang == 'no' else '/en/about/' }}">{{ t.common.readStory }}</a>
    </div>
    <aside class="numbers" aria-label="{{ 'Nøkkeltall' if lang == 'no' else 'Key facts' }}">
      <div><b>1988</b><span>{{ 'Vegplanlegger, Drammen' if lang == 'no' else 'Road designer, Drammen' }}</span></div>
      <div><b>1993</b><span>{{ 'Vianova ringte' if lang == 'no' else 'Vianova called' }}</span></div>
      <div><b>2015</b><span>{{ 'Styreleder ved salget til Trimble' if lang == 'no' else 'Chairman at the sale to Trimble' }}</span></div>
      <div><b>2026</b><span>NovaCoach</span></div>
    </aside>
  </div>
</section>

<section class="form-band on-asfalt">
  <div class="wrap block form-block" id="interesse">
    <h2 class="h2-rule">{{ h.formTitle }}</h2>
    <p class="lead">{{ h.formLead }}</p>
    {% include "form.njk" %}
  </div>
</section>
