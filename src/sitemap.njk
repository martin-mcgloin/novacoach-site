---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in collections.all %}{% if p.url and p.url != '/404.html' and p.url != '/sitemap.xml' %}
  <url><loc>{{ site.url }}{{ p.url }}</loc><xhtml:link rel="alternate" hreflang="{{ 'en' if p.data.lang == 'no' else 'no' }}" href="{{ site.url }}{{ p.data.alt }}"/></url>
{%- endif %}{% endfor %}
</urlset>
